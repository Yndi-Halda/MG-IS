"""Part 1: deterministic trajectory optimization for the vehicle example."""

from __future__ import annotations

import argparse
import csv
from pathlib import Path

import matplotlib.pyplot as plt
import numpy as np
from scipy.optimize import minimize

from vehicle_model import CONFIG, obstacle_margin, simulate_controls


HERE = Path(__file__).resolve().parent
DEFAULT_OUTPUT = HERE / "results" / "optimal_trajectory.npz"


def initial_control_guess() -> np.ndarray:
    """A smooth, feasible lower-right detour around the circle."""
    config = CONFIG
    midpoint_time = (np.arange(config.intervals) + 0.5) * config.dt
    s = midpoint_time / config.final_time
    normal = np.array([1.0, -1.0]) / np.sqrt(2.0)
    bump_amplitude = 1.22
    second_derivative = -(
        bump_amplitude
        * (np.pi / config.final_time) ** 2
        * np.sin(np.pi * s)
    )
    u1 = second_derivative * normal[0]
    u2 = second_derivative * normal[1]
    return np.concatenate([u1, u2])


def objective(controls: np.ndarray) -> float:
    """Discrete approximation of integral(u1^2+u2^2) dt."""
    u1, u2 = np.asarray(controls).reshape(2, CONFIG.intervals)
    effort = CONFIG.dt * np.sum(u1 * u1 + u2 * u2)
    # A tiny regularizer removes nearly indistinguishable high-frequency controls.
    smoothness = 1.0e-5 * np.sum(np.diff(u1) ** 2 + np.diff(u2) ** 2)
    return float(effort + smoothness)


def deterministic_constraints(controls: np.ndarray) -> np.ndarray:
    """All constraints are returned in scipy's >= 0 convention."""
    trajectory = simulate_controls(controls)
    x, y = trajectory["x"], trajectory["y"]
    return np.concatenate(
        [
            x - CONFIG.workspace_low,
            CONFIG.workspace_high - x,
            y - CONFIG.workspace_low,
            CONFIG.workspace_high - y,
            obstacle_margin(x, y),
            np.diff(x) - 1.0e-4,
            np.diff(y) - 1.0e-4,
        ]
    )


def optimize_trajectory(max_iterations: int = 1500):
    guess = initial_control_guess()
    result = minimize(
        objective,
        guess,
        method="SLSQP",
        bounds=[(-3.0, 3.0)] * guess.size,
        constraints={"type": "ineq", "fun": deterministic_constraints},
        options={"maxiter": max_iterations, "ftol": 1.0e-10, "disp": True},
    )
    if not result.success:
        raise RuntimeError(f"Trajectory optimization failed: {result.message}")
    if np.min(deterministic_constraints(result.x)) < -1.0e-6:
        raise RuntimeError("Optimizer returned a constraint-violating trajectory")
    return result, simulate_controls(result.x)


def save_results(result, trajectory: dict[str, np.ndarray], output_path: Path) -> None:
    output_path.parent.mkdir(parents=True, exist_ok=True)
    minimum_margin = float(np.min(obstacle_margin(trajectory["x"], trajectory["y"])))
    np.savez(
        output_path,
        **trajectory,
        objective=np.array(result.fun),
        minimum_margin=np.array(minimum_margin),
    )

    csv_path = output_path.with_suffix(".csv")
    with csv_path.open("w", newline="", encoding="utf-8-sig") as handle:
        writer = csv.writer(handle)
        writer.writerow(["time", "x", "y", "vx", "vy", "u1", "u2", "obstacle_margin"])
        margin = obstacle_margin(trajectory["x"], trajectory["y"])
        for k, time in enumerate(trajectory["time"]):
            u1 = trajectory["u1"][k] if k < CONFIG.intervals else ""
            u2 = trajectory["u2"][k] if k < CONFIG.intervals else ""
            writer.writerow(
                [time, trajectory["x"][k], trajectory["y"][k], trajectory["vx"][k],
                 trajectory["vy"][k], u1, u2, margin[k]]
            )

    # Paper-style obstacle-avoidance figure.  In addition to the original
    # trajectory and obstacle, mark the start, target, and obstacle diameter.
    plt.rcParams.update(
        {
            "font.family": "serif",
            "font.serif": ["Times New Roman", "DejaVu Serif"],
            "mathtext.fontset": "stix",
        }
    )
    figure, axis = plt.subplots(figsize=(7.0, 6.0))
    axis.plot(
        trajectory["x"],
        trajectory["y"],
        color="blue",
        linestyle="--",
        linewidth=2.2,
        dashes=(6, 4),
        label="Optimal trajectory",
        zorder=3,
    )
    obstacle = plt.Circle(
        (CONFIG.obstacle_x, CONFIG.obstacle_y),
        CONFIG.obstacle_radius,
        facecolor="#fff7a8",
        edgecolor="#e6d900",
        linewidth=1.8,
        alpha=0.90,
        label="Obstacle area",
        zorder=1,
    )
    axis.add_patch(obstacle)

    diameter_left = CONFIG.obstacle_x - CONFIG.obstacle_radius
    diameter_right = CONFIG.obstacle_x + CONFIG.obstacle_radius
    axis.annotate(
        "",
        xy=(diameter_right, CONFIG.obstacle_y),
        xytext=(diameter_left, CONFIG.obstacle_y),
        arrowprops={"arrowstyle": "<->", "color": "black", "linewidth": 1.4},
        zorder=4,
    )
    axis.text(
        CONFIG.obstacle_x,
        CONFIG.obstacle_y + 0.08,
        rf"$D=2r={2.0 * CONFIG.obstacle_radius:.1f}\,\mathrm{{m}}$",
        ha="center",
        va="bottom",
        fontsize=12,
        zorder=4,
    )
    axis.plot(
        CONFIG.start_x,
        CONFIG.start_y,
        marker="o",
        ms=8,
        color="forestgreen",
        markeredgecolor="black",
        label="Start point",
        zorder=5,
    )
    axis.plot(
        CONFIG.target_x,
        CONFIG.target_y,
        marker="*",
        ms=14,
        color="red",
        markeredgecolor="black",
        label="Target point",
        zorder=5,
    )
    axis.set(
        xlim=(-0.5, 3.5),
        ylim=(-0.5, 3.5),
        xlabel=r"$x\ (\mathrm{m})$",
        ylabel=r"$y\ (\mathrm{m})$",
    )
    axis.set_aspect("equal", adjustable="box")
    axis.grid(True, color="0.75", linewidth=0.8, alpha=0.65)
    axis.legend(loc="upper left", bbox_to_anchor=(0.12, 0.98), frameon=True, fontsize=10.5)
    axis.tick_params(labelsize=11)
    figure.tight_layout()
    figure.savefig(output_path.with_name("deterministic_trajectory.png"), dpi=220)
    figure.savefig(output_path.with_name("deterministic_trajectory.pdf"), bbox_inches="tight")
    plt.close(figure)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument("--max-iterations", type=int, default=1500)
    arguments = parser.parse_args()
    result, trajectory = optimize_trajectory(arguments.max_iterations)
    save_results(result, trajectory, arguments.output)
    minimum_margin = float(np.min(obstacle_margin(trajectory["x"], trajectory["y"])))
    print(f"Objective J                 : {result.fun:.8f}")
    print(f"Minimum obstacle margin    : {minimum_margin:.8e}")
    print(f"Minimum geometric clearance: {np.sqrt(minimum_margin + CONFIG.obstacle_radius**2) - CONFIG.obstacle_radius:.8e}")
    print(f"Trajectory written to      : {arguments.output.resolve()}")


if __name__ == "__main__":
    main()
